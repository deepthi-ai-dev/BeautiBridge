generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ARTIST
}

model User {
  id            String    @id @default(cuid())
  name          String?
  phone         String?
  city          String?
  dob           String?
  address       String?
  experience    String?
  about         String?
  languages     String?
  hobbies       String?
  instagram     String?
  facebook      String?
  pricing       Int?
  specialties   String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole?
  accounts      Account[]
  sessions      Session[]
  
  services        ServicePackage[] @relation("ArtistServices")
  customerBookings Booking[]       @relation("CustomerBookings")
  artistBookings  Booking[]        @relation("ArtistBookings")
  customerReviews Review[]         @relation("CustomerReviews")
  artistReviews   Review[]         @relation("ArtistReviews")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ServicePackage {
  id          String   @id @default(cuid())
  artistId    String
  artist      User     @relation("ArtistServices", fields: [artistId], references: [id], onDelete: Cascade)
  name        String
  description String?
  duration    String
  price       Int
  isPopular   Boolean  @default(false)
  includes    String   // Stored as CSV or JSON string
  bookings    Booking[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Booking {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation("CustomerBookings", fields: [userId], references: [id], onDelete: Cascade)
  artistId  String
  artist    User           @relation("ArtistBookings", fields: [artistId], references: [id], onDelete: Cascade)
  serviceId String
  service   ServicePackage @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  date      String         // e.g. "2026-07-15"
  time      String         // e.g. "10:00 AM"
  status    BookingStatus  @default(PENDING)
  notes     String?

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation("CustomerReviews", fields: [authorId], references: [id], onDelete: Cascade)
  artistId  String
  artist    User     @relation("ArtistReviews", fields: [artistId], references: [id], onDelete: Cascade)
  rating    Int
  service   String?
  body      String
  helpful   Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
